# Cloudflare static assets (wrangler.jsonc). Rules must not overlap: matching
# rules' headers are merged.

# The page: always revalidated, so a deploy shows at once.
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate

# Vite's hashed JS, CSS and fonts; the hashed model buffers and textures
# (scripts/hash-models.mjs).
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/models/immutable/*
  Cache-Control: public, max-age=31536000, immutable

# The glTFs keep their names (the bake rewrites them): small, revalidated.
/models/baked/*
  Cache-Control: public, max-age=0, must-revalidate
/models/props/*
  Cache-Control: public, max-age=0, must-revalidate

# Unhashed and rarely changed: an hour, then served stale while refreshing.
/world/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
/still/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
/favicon.svg
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
/favicon-32.png
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
/apple-touch-icon.png
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
/og.jpg
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
